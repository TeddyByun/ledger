// ═════════════════════════════════════════════════════════════════════════════
// TRANSACTION (_tt) — 마스터·코드·부모업무를 인라인 uuid 로 참조 (§8.1)
//   household_id 를 인라인으로 갖기 때문에 Prisma 미들웨어 자동 스코핑이 유효하다
// ═════════════════════════════════════════════════════════════════════════════

/// 거래 (수입/지출 공용)
model TransactionTt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String    @map("household_id") @db.Uuid
  /// → transaction_ct.id (TRANSACTION_TYPE)
  typeId          String    @map("type_id") @db.Uuid
  /// → transaction_ct.id (TRANSACTION_STATUS)
  statusId        String    @map("status_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  counterpartyId  String?   @map("counterparty_id") @db.Uuid
  paymentMethodId String    @map("payment_method_id") @db.Uuid
  /// 지출 명의 — 계정이 아니라 사람(family_member_mt)을 가리킨다
  familyMemberId  String?   @map("family_member_id") @db.Uuid
  description     String?
  /// v1 은 nullable 이었다 → NOT NULL 로 강화 (합계에서 조용히 누락되는 문제)
  amount          Decimal   @db.Decimal(15, 2)
  transactionDate DateTime  @map("transaction_date") @db.Date
  settledDate     DateTime? @map("settled_date") @db.Date
  memo            String?
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category      CategoryMt      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  counterparty  CounterpartyMt? @relation(fields: [counterpartyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentMethod PaymentMethodMt @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  familyMember  FamilyMemberMt? @relation(fields: [familyMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  bankTransaction BankTransactionTt?
  cardTransaction CardTransactionTt?

  // (householdId, ...) 복합은 테넌트 조회용.
  @@index([householdId, transactionDate])
  @@index([householdId, categoryId])
  @@index([householdId, paymentMethodId])
  // 단일 컬럼은 역방향 정합성 검사용 — 물리 FK 가 없으므로 "이 분류/결제수단을
  // 참조하는 거래가 있는가?"를 앱이 쿼리로 확인해야 한다(설계서 §6.4).
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([counterpartyId])
  @@index([familyMemberId])
  @@index([typeId])
  @@index([statusId])
  @@map("transaction_tt")
}

/// 은행 거래내역 (원천 적재)
model BankTransactionTt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String    @map("household_id") @db.Uuid
  paymentMethodId String    @map("payment_method_id") @db.Uuid
  transactionId   String?   @unique @map("transaction_id") @db.Uuid
  /// → statement_ct.id (BANK_TXN_TYPE)
  txnTypeId       String?   @map("txn_type_id") @db.Uuid
  /// → transaction_ct.id (EXCLUDE_REASON)
  excludeReasonId String?   @map("exclude_reason_id") @db.Uuid
  /// 이관 시 KST 벽시계 값 보존 필요 (설계서 §5.4 주석)
  txnAt           DateTime  @map("txn_at") @db.Timestamptz
  /// 발급사 원문 보존 — 코드화하지 않는다
  txnTypeRaw      String?   @map("txn_type_raw") @db.VarChar(100)
  counterpartOrg  String?   @map("counterpart_org") @db.VarChar(200)
  description     String?
  withdrawal      Decimal   @default(0) @db.Decimal(15, 2)
  deposit         Decimal   @default(0) @db.Decimal(15, 2)
  balance         Decimal?  @db.Decimal(15, 2)
  branch          String?   @db.VarChar(100)
  isClassified    Boolean   @default(false) @map("is_classified")
  importBatch     String?   @map("import_batch") @db.VarChar(50)
  dedupHash       String?   @map("dedup_hash") @db.VarChar(64)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  paymentMethod PaymentMethodMt @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transaction   TransactionTt?  @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([householdId, dedupHash])
  @@index([householdId, txnAt])
  @@index([paymentMethodId])
  @@index([isClassified])
  @@map("bank_transaction_tt")
}

/// 카드 명세서 (원천 적재)
model CardStatementTt {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      String    @map("household_id") @db.Uuid
  paymentMethodId  String    @map("payment_method_id") @db.Uuid
  settleAccountId  String?   @map("settle_account_id") @db.Uuid
  statementYm      String    @map("statement_ym") @db.Char(7)
  billingDate      DateTime? @map("billing_date") @db.Date
  settleAccountRaw String?   @map("settle_account_raw") @db.VarChar(100)
  totalAmount      Decimal?  @map("total_amount") @db.Decimal(15, 2)
  lumpSum          Decimal   @default(0) @map("lump_sum") @db.Decimal(15, 2)
  installmentAmt   Decimal   @default(0) @map("installment_amt") @db.Decimal(15, 2)
  cashAdvance      Decimal   @default(0) @map("cash_advance") @db.Decimal(15, 2)
  cardLoan         Decimal   @default(0) @map("card_loan") @db.Decimal(15, 2)
  revolving        Decimal   @default(0) @db.Decimal(15, 2)
  annualFee        Decimal   @default(0) @map("annual_fee") @db.Decimal(15, 2)
  prevUnpaid       Decimal   @default(0) @map("prev_unpaid") @db.Decimal(15, 2)
  lateFee          Decimal   @default(0) @map("late_fee") @db.Decimal(15, 2)
  totalCount       Int?      @map("total_count")
  benefitTotal     Decimal   @default(0) @map("benefit_total") @db.Decimal(15, 2)
  creditFrom       DateTime? @map("credit_from") @db.Date
  creditTo         DateTime? @map("credit_to") @db.Date
  createdDate      DateTime? @map("created_date") @db.Date
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  card          PaymentMethodMt     @relation("CardOfStatement", fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settleAccount PaymentMethodMt?    @relation("SettleAccount", fields: [settleAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions  CardTransactionTt[]

  @@unique([paymentMethodId, statementYm])
  @@index([householdId])
  @@index([settleAccountId])
  @@map("card_statement_tt")
}

/// 카드 이용내역 (원천 적재)
model CardTransactionTt {
