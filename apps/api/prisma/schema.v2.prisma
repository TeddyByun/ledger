  transaction     TransactionTt?     @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  installmentPlan InstallmentPlanTt? @relation(fields: [installmentPlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([householdId, dedupHash])
  @@index([householdId, txnDate])
  @@index([statementId])
  @@index([paymentMethodId])
  @@index([installmentPlanId])
  @@index([isClassified])
  @@map("card_transaction_tt")
}

